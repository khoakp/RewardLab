<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny-by-default: Cleartext HTTP traffic is blocked by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext HTTP permitted strictly for authorized RewardLab test endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Physical LG-H872 testing on local LAN -->
        <domain includeSubdomains="false">192.168.1.122</domain>
        <!-- Windows Host Wi-Fi IP for direct LAN access -->
        <domain includeSubdomains="false">172.16.1.2</domain>
        <!-- Android Emulator Host Loopback -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Local ADB Reverse Port Forwarding Loopback -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
